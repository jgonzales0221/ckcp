
---
import Base from "../layouts/Base.astro";
import teamData from "../data/team.json";

const members = teamData.members;
---

<Base>
  <section class="page">
    <h1>Our Team</h1>

    <div class="team-grid">
      {members.map((member) => (
        <div class="team-card">
          <img
            src={member.photo || "/favicon.png"}
            alt={member.name}
          />

          <h2>{member.name}</h2>

          <p class="role">{member.role}</p>

          {member.phone && (
            <p>{member.phone}</p>
          )}

          {member.notes && (
            <p>{member.notes}</p>
          )}

          {member.email && (
            <p>
              <a href={`mailto:${member.email}`}>
                {member.email}
              </a>
            </p>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .team-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem;
    text-align: center;
  }

  .team-card img {
    width: 140px;
    height: 140px;
    object-fit: contain;
    object-position: center;
    background: #f0f0f0;
    border-radius: 50%;
    margin-bottom: 0.75rem;
    padding: 4px;
  }

  .team-card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
    border: none;
    padding: 0;
    color: var(--blue);
  }

  .team-card .role {
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--gold);
  }

  .team-card p {
    margin: 0.2rem 0;
    font-size: 0.95rem;
  }

  .team-card a {
    color: var(--blue);
    text-decoration: none;
  }

  .team-card a:hover {
    text-decoration: underline;
  }
</style>
