<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .team-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem;
    text-align: center;
  }

.team-card img {
  width: 140px;
  height: 140px;
  object-fit: contain;          /* shows the full photo, no cropping */
  object-position: center;
  background: #f0f0f0;          /* fills the empty space in the circle */
  border-radius: 50%;
  margin-bottom: 0.75rem;
  padding: 4px;                 /* optional breathing room */
}

  .team-card h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
    border: none;
    padding: 0;
    color: var(--blue);
  }

  .team-card .role {
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--gold);
  }

  .team-card p {
    margin: 0.2rem 0;
    font-size: 0.95rem;
  }

  .team-card a {
    color: var(--blue);
    text-decoration: none;
  }

  .team-card a:hover {
    text-decoration: underline;
  }
</style>