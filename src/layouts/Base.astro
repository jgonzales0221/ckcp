<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Christ the King Catholic Parish</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">Christ the King Catholic Parish</a>
      <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/sacraments">Sacraments</a></li>
            <li><a href="/formation">Formation</a></li>
            <li><a href="/get-involved">Get Involved</a></li>
            <li><a href="/news">News</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>
    <main class="content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  :root {
    --ink: #1c2834;
    --blue: #245f9f;
    --gold: #b0893e;
    --paper: #f7f5f1;
    --line: #e4ddd2;
  }

  header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px 24px;
  background: #ffffff;
  border-bottom: 3px solid var(--gold);
  padding: 12px 24px;
}

header a.brand {
  font-family: "Libre Baskerville" serif;
  font-size: 1.8rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--blue);
  text-decoration: none;
}

nav ul {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px 16px;
  list-style: none;
  margin: 0;
  padding: 0;
}

nav a {
  color: var(--ink);
  font-size: 1.3rem;
  text-decoration: none;
  white-space: nowrap;
}

nav a:hover {
  color: var(--blue);
}

@media (max-width: 900px) {
  header {
    flex-direction: column;
    align-items: flex-start;
  }

  nav ul {
    justify-content: flex-start;
  }
}
</style>
