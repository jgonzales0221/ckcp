<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Christ the King Catholic Parish</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">Christ the King Catholic Parish</a>
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/sacraments">Sacraments</a></li>
          <li><a href="/formation">Formation</a></li>
          <li><a href="/get-involved">Get Involved</a></li>
          <li><a href="/bulletin">Bulletin</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main class="content">
      <slot />
    </main>

    <footer>
      <div class="footer-bottom">
        <p>© 2026 Christ the King Catholic Parish</p>
        <p>A parish of the <a href="https://dioceseofpueblo.org" target="_blank" rel="noopener">Diocese of Pueblo</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  :root {
    --ink: #1c2834;
    --blue: #245f9f;
    --gold: #b0893e;
    --paper: #f7f5f1;
    --line: #e4ddd2;
  }

  body {
    margin: 0;
    background: #F5F0E6;
    color: var(--ink);
    font-family: "Source Sans 3", sans-serif;
  }

  .page {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 12px 32px 64px;
    box-sizing: border-box;
  }

  h1 {
    text-align: center;
    color: var(--gold);
    font-weight: 600;
    margin: 0 0 0.75rem;
    padding-bottom: 0.6rem;
  }

  .quote {
    text-align: center;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0.4rem 0 0.8rem;
  }

  .subtitle {
    text-align: center;
    font-weight: bold;
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0.4rem 0 0.8rem;
  }

  h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--gold);
    font-family: "Source Sans 3", sans-serif;
    font-size: 1.6rem;
    color: var(--blue);
  }

  h3 {
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
    font-family: "Source Sans 3", sans-serif;
    font-size: 1.2rem;
    color: var(--blue);
  }

  p {
    margin: 0.4rem 0 0.8rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin: 0.4rem 0 1.25rem;
  }

  li {
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    background: #eee7c9;
    border-bottom: 3px solid var(--gold);
    padding: 12px 24px;
  }

  header a.brand {
    font-family: "Libre Baskerville", serif;
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--blue);
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--ink);
    font-size: 1.3rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--blue);
  }

  footer {
    background: #eee7c9;
    border-top: 3px solid var(--gold);
    padding: 1.5rem 24px;
    text-align: center;
  }

  .footer-bottom p {
    margin: 0.25rem 0;
    font-size: 0.95rem;
  }

  .footer-bottom a {
    color: var(--blue);
    text-decoration: none;
  }

  .footer-bottom a:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    header {
      flex-direction: column;
      align-items: flex-start;
    }

    nav ul {
      justify-content: flex-start;
    }
  }
</style>
